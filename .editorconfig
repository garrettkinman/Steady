# https://editorconfig.org
#
# The whole repository is spaces, LF, UTF-8, with a newline at the end of every
# file. Linker scripts and shell scripts included — nothing here is
# tab-sensitive.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so trimming them
# silently changes how a document renders.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
