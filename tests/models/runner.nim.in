#
# Template. `tests/models/check.sh` substitutes @MODEL@ and drops a copy next
# to the generated module, so that `import ./@MODEL@` resolves without a search
# path and the model's companion weights .c is found relative to it.

## Differential runner for one model.
##
##   runner gen   <model.tflite> <io.txt> <trials>   choose inputs, state the
##                                                   quantization at both ends
##   runner check <io.txt> <ref.txt> <tolerance>     run the compiled model and
##                                                   compare with TFLite
##
## Inputs are chosen here rather than in the reference script because the graph
## input's quantization is something only the importer knows: after a boundary
## QUANTIZE is stripped, the model's input is a tensor that was internal to the
## file.

import std/[os, strutils, strformat, sequtils, tables]
import steadyc
import ./@MODEL@ as model

proc lcg(seed: uint32, n: int, lo, hi: int32): seq[int32] =
  ## Uniform over the store's range, int8's or int16's.
  result = newSeq[int32](n)
  var s = seed
  for i in 0 ..< n:
    s = s * 1664525'u32 + 1013904223'u32
    result[i] = lo + int32((s shr 16) and uint32(hi - lo))

proc constant(v: int32, n: int): seq[int32] =
  newSeqWith(n, v)

proc trialsFor(nIn: int, count: int, inZero: int32, store: DType): seq[seq[int32]] =
  ## Random draws, plus the corners. Saturation and the zero point are where a
  ## quantized kernel and a reference implementation part company, so they are
  ## not left to chance.
  let (lo, hi) = if store == dtInt16: (-32768'i32, 32767'i32) else: (-128'i32, 127'i32)
  result.add constant(inZero, nIn)
  result.add constant(lo, nIn)
  result.add constant(hi, nIn)
  for i in 0 ..< count:
    result.add lcg(97'u32 + uint32(i) * 7919'u32, nIn, lo, hi)

proc fileName(name: string): string

proc idTrials(n, rows, count: int): seq[seq[int32]] =
  ## Indices into a table of `rows`: its first row, its last, and draws
  result.add constant(0, n)
  result.add constant(int32(rows - 1), n)
  for i in 0 ..< count + 1:
    result.add lcg(193'u32 + uint32(i) * 7919'u32, n, 0, 65535).mapIt(it mod int32(rows))

proc trialsOf(g: Graph, t: int, count: int): seq[seq[int32]] =
  ## For one input: an int32 one indexes a table, whose size the gather that
  ## reads it says; a store, its whole range
  let tt = g.tensors[t]
  if tt.dtype == dtInt32:
    for op in g.ops:
      if op.kind == okGather and op.inputs[1] == t:
        return idTrials(tt.numElements, g.tensors[op.inputs[0]].shape[0], count)
    quit &"FAIL: int32 input '{tt.name}' is not the indices of a gather", 1
  let zero = if tt.quant.zeroPoints.len > 0: tt.quant.zeroPoints[0] else: 0'i32
  trialsFor(tt.numElements, count, zero, tt.dtype)

proc portLines(g: Graph): string =
  for (key, ts) in [("input", g.inputs), ("output", g.outputs)]:
    var names, sizes: seq[string]
    for t in ts:
      names.add fileName(g.tensors[t].name)
      sizes.add $g.tensors[t].numElements
    result.add &"{key}_names {names.join(\" \")}\n{key}_sizes {sizes.join(\" \")}\n"

proc genBounded(g: Graph, modelPath, ioPath: string) =
  ## A model taking a length: each trial at a length of its own, the first
  ## short, as the per-tensor pass simulates it, then the ends of the range
  let lengths = [min(37, g.bound), 1, 2, 5, g.bound div 2 + 1, g.bound]
  var s = &"model {g.name}\npath {modelPath}\nbound {g.bound}\n" & portLines(g)
  for k, n in lengths:
    let at = g.atLength(n)
    var line = &"trial {n}"
    for t in at.inputs:
      let draws = trialsOf(at, t, 1)
      for v in draws[draws.high - k mod 2]: line.add " " & $v
    s.add line & "\n"
  writeFile(ioPath, s)
  echo &"    {lengths.len} trials at lengths {lengths}, {g.inputs.len} inputs, {g.outputs.len} outputs"

proc gen(modelPath, ioPath: string, count, bound: int) =
  let g = importTfliteFile(modelPath, bound = bound)
  if g.bound > 0:
    genBounded(g, modelPath, ioPath)
    return
  if g.inputs.len > 1 or g.outputs.len > 1:
    # Each trial is every input, in the graph's order, end to end; each
    # reference every output. The names say which is which.
    var s = &"model {g.name}\n"
    var total = 0
    for (key, ts) in [("input", g.inputs), ("output", g.outputs)]:
      var names, sizes, stores: seq[string]
      for t in ts:
        names.add fileName(g.tensors[t].name)
        sizes.add $g.tensors[t].numElements
        stores.add $g.tensors[t].dtype
      s.add &"{key}_names {names.join(\" \")}\n{key}_sizes {sizes.join(\" \")}\n" &
            &"{key}_stores {stores.join(\" \")}\n"
    for t in g.outputs: total += g.tensors[t].numElements
    s.add &"outputs {total}\n"
    var each: seq[seq[seq[int32]]]
    for t in g.inputs: each.add trialsOf(g, t, count)
    let n = min(each.mapIt(it.len))
    for k in 0 ..< n:
      var line = "trial"
      for e in each:
        for v in e[k]: line.add " " & $v
      s.add line & "\n"
    writeFile(ioPath, s)
    echo &"    {n} trials, {g.inputs.len} inputs, {g.outputs.len} outputs"
    return
  let inT = g.tensors[g.inputs[0]]
  let outT = g.tensors[g.outputs[0]]
  let inZero = if inT.quant.zeroPoints.len > 0: inT.quant.zeroPoints[0] else: 0'i32
  let outZero = if outT.quant.zeroPoints.len > 0: outT.quant.zeroPoints[0] else: 0'i32
  let inScale = if inT.quant.scales.len > 0: inT.quant.scales[0] else: 1.0
  let outScale = if outT.quant.scales.len > 0: outT.quant.scales[0] else: 1.0

  var s = &"model {g.name}\n"
  s.add &"inputs {inT.numElements}\n"
  s.add &"outputs {outT.numElements}\n"
  s.add &"in_scale {inScale:.17e}\n"
  s.add &"in_zero {inZero}\n"
  s.add &"out_scale {outScale:.17e}\n"
  s.add &"out_zero {outZero}\n"
  for t in trialsFor(inT.numElements, count, inZero, inT.dtype):
    var line = "trial"
    for v in t: line.add " " & $v
    s.add line & "\n"
  writeFile(ioPath, s)
  echo &"    {trialsFor(inT.numElements, count, inZero, inT.dtype).len} trials, " &
       &"{inT.numElements} in, {outT.numElements} out"

proc readTrials(path: string): tuple[meta: seq[(string, string)], trials: seq[seq[int32]]] =
  for line in path.lines:
    let l = line.strip
    if l.len == 0 or l.startsWith("#"): continue
    let sp = l.find(' ')
    if sp < 0: continue
    let key = l[0 ..< sp]
    let rest = l[sp + 1 .. ^1]
    if key == "trial":
      var vals: seq[int32]
      for f in rest.splitWhitespace: vals.add int32(parseInt(f))
      result.trials.add vals
    else:
      result.meta.add (key, rest)

template withPort(kind: untyped, k: int, p, body: untyped) =
  ## The model's input or output `k`, as `p`, if it has one
  when compiles(`kind 0`()):
    if k == 0:
      let p = `kind 0`()
      body
  when compiles(`kind 1`()):
    if k == 1:
      let p = `kind 1`()
      body
  when compiles(`kind 2`()):
    if k == 2:
      let p = `kind 2`()
      body

proc metaOf(io: tuple[meta: seq[(string, string)], trials: seq[seq[int32]]], key: string): string =
  for (k, v) in io.meta:
    if k == key: return v

proc checkBounded(io, reference: tuple[meta: seq[(string, string)], trials: seq[seq[int32]]],
                  tolerance: int) =
  ## Each trial at its own length, through `invoke(n)`
  let g = importTfliteFile(metaOf(io, "path"), bound = parseInt(metaOf(io, "bound")))
  var worst = 0
  var exact = 0
  for i, trial in io.trials:
    let n = int(trial[0])
    let at = g.atLength(n)
    var pos = 1
    for k, t in at.inputs:
      withPort(input, k, p):
        for j in 0 ..< at.tensors[t].numElements: p[j] = typeof(p[0])(trial[pos + j])
      pos += at.tensors[t].numElements
    when compiles(model.invoke(1)): model.invoke(n)
    var got: seq[int32]
    for k, t in at.outputs:
      withPort(output, k, p):
        for j in 0 ..< at.tensors[t].numElements: got.add int32(p[j])
    let want = reference.trials[i]
    if want.len != got.len:
      quit &"FAIL: at length {n} the reference has {want.len} values and the model {got.len}", 1
    var d = 0
    for j in 0 ..< got.len: d = max(d, abs(int(got[j]) - int(want[j])))
    if d == 0: inc exact
    worst = max(worst, d)
  echo &"    {io.trials.len} trials at their own lengths  identical outputs {exact}/{io.trials.len}  max diff {worst}"
  if worst > tolerance:
    quit &"FAIL: max difference {worst} exceeds the tolerance of {tolerance}", 1

proc check(ioPath, refPath: string, tolerance: int) =
  let io = readTrials(ioPath)
  if metaOf(io, "bound").len > 0:
    checkBounded(io, readTrials(refPath), tolerance)
    return
  let reference = readTrials(refPath)
  var nOut = 0
  for (k, v) in io.meta:
    if k == "outputs": nOut = parseInt(v)
  if io.trials.len != reference.trials.len:
    quit &"FAIL: {io.trials.len} inputs but {reference.trials.len} reference outputs", 1

  var worst = 0
  var mismatched = 0
  var total = 0
  var top1 = 0
  var exact = 0

  var sizes: seq[int]
  for (k, v) in io.meta:
    if k == "input_sizes": sizes = v.splitWhitespace.mapIt(parseInt(it))
  if sizes.len == 0: sizes = @[io.trials[0].len]
  var outSizes = @[nOut]
  for (k, v) in io.meta:
    if k == "output_sizes": outSizes = v.splitWhitespace.mapIt(parseInt(it))

  for i, input in io.trials:
    var at = 0
    for k, n in sizes:
      withPort(input, k, p):
        for j in 0 ..< n: p[j] = typeof(p[0])(input[at + j])
      at += n
    when compiles(model.invoke()): model.invoke()
    var outp: seq[int32]
    for k, n in outSizes:
      withPort(output, k, p):
        for j in 0 ..< n: outp.add int32(p[j])

    let want = reference.trials[i]
    if want.len != nOut:
      quit &"FAIL: trial {i} reference has {want.len} values, expected {nOut}", 1

    var trialWorst = 0
    var gotBest = 0
    var wantBest = 0
    for j in 0 ..< nOut:
      let got = int(outp[j])
      let d = abs(got - int(want[j]))
      inc total
      if d > 0: inc mismatched
      if d > trialWorst: trialWorst = d
      if got > int(outp[gotBest]): gotBest = j
      if want[j] > want[wantBest]: wantBest = j
    if trialWorst == 0: inc exact
    if gotBest == wantBest: inc top1
    if trialWorst > worst: worst = trialWorst

  let pct = 100.0 * float(total - mismatched) / float(total)
  echo &"    {io.trials.len} trials  identical outputs {exact}/{io.trials.len}  " &
       &"elements equal {pct:.3f}%  max diff {worst}  " &
       &"argmax agrees {top1}/{io.trials.len}"
  if worst > tolerance:
    quit &"FAIL: max difference {worst} exceeds the tolerance of {tolerance}", 1

proc fileName(name: string): string =
  ## The tensor's name in the model file. The importer appends `_t<index>` to
  ## one that collides with another as an identifier, and TFLite's dump has
  ## it as written; matched only as given, such tensors went uncompared.
  let i = name.rfind("_t")
  if i > 0 and i + 2 < name.len and name[i + 2 .. ^1].allCharsInSet(Digits):
    name[0 ..< i]
  else:
    name

proc tensors(modelPath, ioPath, refPath: string) =
  ## Per-operator attribution. Runs the *simulator* over trial 0 and compares
  ## every intermediate against TFLite's, matched by tensor name.
  ##
  ## The gate is not "everything matches" but "the first thing that does not
  ## match is an operator we have already accounted for". Desktop TFLite
  ## evaluates int8 FULLY_CONNECTED and the generic MEAN reducer in float; its
  ## convolutions use gemmlowp fixed point, which is what this compiler,
  ## CMSIS-NN and TFLite Micro all do. So those two drifting by an LSB is
  ## explained, and a convolution drifting is a regression — this distinguishes
  ## them instead of averaging both into one tolerance.
  ##
  ## For MEAN the difference is not even in TFLite's favour: on the four
  ## MobileNetV2 channels where the two disagree, the exact real value is
  ## nearer our answer than theirs, because their float path mis-rounds just
  ## past a tie. See the note in tests/models/check.sh.
  let io = readTrials(ioPath)
  if io.trials.len == 0: quit "FAIL: no trials", 1
  let bound = metaOf(io, "bound")
  # A model taking a length is simulated at the first trial's
  let g = if bound.len > 0:
            importTfliteFile(modelPath, bound = parseInt(bound)).atLength(int(io.trials[0][0]))
          else: importTfliteFile(modelPath)

  var inputs = initTable[int, seq[int32]]()
  var at = if bound.len > 0: 1 else: 0
  for t in g.inputs:
    let n = g.tensors[t].numElements
    inputs[t] = io.trials[0][at ..< at + n]
    at += n
  let bufs = simulate(g, inputs)

  var reference = initTable[string, seq[int32]]()
  for line in refPath.lines:
    let tab = line.find('\t')
    if tab < 0: continue
    var vals: seq[int32]
    for f in line[tab + 1 .. ^1].splitWhitespace: vals.add int32(parseInt(f))
    reference[line[0 ..< tab]] = vals

  # Which tensors are produced by a fully-connected op, and in what order the
  # graph computes them.
  var producedBy = initTable[int, OpKind]()
  for op in g.ops:
    producedBy[op.outputs[0]] = op.kind

  var compared = 0
  var exact = 0
  var firstBad = -1
  var worst = 0
  for ti, t in g.tensors:
    if t.dtype notin {dtInt8, dtInt16} or ti notin bufs: continue
    let name = if t.name in reference: t.name else: fileName(t.name)
    if name notin reference: continue
    let want = reference[name]
    let got = bufs[ti]
    if want.len != got.len: continue
    inc compared
    var d = 0
    for i in 0 ..< got.len:
      let diff = abs(int(got[i]) - int(want[i]))
      if diff > d: d = diff
    if d == 0:
      inc exact
    else:
      if d > worst: worst = d
      if firstBad < 0: firstBad = ti
      let kind = if ti in producedBy: $producedBy[ti] else: "graph input"
      echo &"      diverges by {d} at '{t.name[0 .. min(48, t.name.high)]}' ({kind})"

  echo &"    {exact}/{compared} intermediate tensors bit-identical" &
       (if worst > 0: &", worst {worst} LSB" else: "")
  if firstBad >= 0:
    let kind = if firstBad in producedBy: producedBy[firstBad] else: okReshape
    const Explained = {okFullyConnected, okMean}
    if kind notin Explained:
      echo &"FAIL: the first divergence is a {kind}. Only {Explained} are " &
           "known to differ from desktop TFLite, because it evaluates those " &
           "in float; the integer path is expected to be exact everywhere else"
      quit 1

when isMainModule:
  let args = commandLineParams()
  if args.len < 1: quit "usage: runner gen|check ...", 1
  case args[0]
  of "gen":
    if args.len < 4: quit "usage: runner gen <model.tflite> <io.txt> <trials> [bound]", 1
    gen(args[1], args[2], parseInt(args[3]), if args.len > 4: parseInt(args[4]) else: 0)
  of "check":
    if args.len < 4: quit "usage: runner check <io.txt> <ref.txt> <tolerance>", 1
    check(args[1], args[2], parseInt(args[3]))
  of "tensors":
    if args.len < 4: quit "usage: runner tensors <model.tflite> <io.txt> <all.txt>", 1
    tensors(args[1], args[2], args[3])
  else:
    quit &"unknown mode '{args[0]}'", 1
