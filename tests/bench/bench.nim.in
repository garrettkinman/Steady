#
# Template. `tests/bench/check.sh` substitutes @MODEL@ and drops a copy next to
# the generated module, so `import ./@MODEL@` resolves without a search path and
# the companion weights .c is found relative to it.

## Benchmark driver for one model.
##
## Reports two things, and the second is the one that changes decisions:
##
##   * whole-inference time, and MAC/s derived from the host's own count of the
##     multiply-accumulates the kernels perform — padded taps included, since
##     the kernels multiply them rather than skipping them.
##   * per-operator time, from the `invokeOp` entry points a `-d:steadyProfile`
##     build emits. Milliseconds alone say which layer is slow; MAC/s per layer
##     says whether that is because it does more work or because its kernel is
##     worse, and only the second is worth acting on.
##
## Two properties of this runtime make per-op timing legitimate, and they are
## worth stating because they are not true of an interpreter:
##
##   * `invoke` and `invokeOp` contain the *same* emitted calls. There is no
##     dispatch layer whose overhead would be attributed to one and not the
##     other, and no instrumentation inside `invoke` at all — the profiled
##     build measures the code the unprofiled build runs.
##   * int8 kernels are data-independent. Their loop bounds come from shapes,
##     not values, so re-running one op on whatever the arena happens to hold
##     costs what it costs on real data. Only `maxPool2d` branches on data at
##     all, and only to update a register.
##
## What it does *not* model is cache state: an op timed in a loop finds its
## input hot, where in a real inference it is as cold as the previous op left
## it. So the sum of the parts is optimistic against the whole, and the harness
## prints both rather than pretending one is the other.

import std/[os, strutils, strformat, monotimes, times, algorithm, tables]
import ./@MODEL@ as model

when not defined(steadyProfile):
  {.error: "build the benchmark with -d:steadyProfile so `invokeOp` exists".}

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# TIMING
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# The statistic is the *minimum* over repetitions, not the mean. Everything
# this measurement is contaminated by — a migration to another core, a
# frequency change, another process — makes a sample slower and nothing makes
# it faster, so the minimum is the closest estimate of the machine's actual
# throughput available. The median is printed next to it: if the two are far
# apart the host was too busy for the number to mean anything.

type Timing = object
  best*, median*: float        ## seconds per iteration
  iters*, reps*: int

proc timeIters(run: proc(), iters: int): float =
  let t0 = getMonoTime()
  for _ in 0 ..< iters: run()
  float((getMonoTime() - t0).inNanoseconds) / 1e9

proc calibrate(run: proc(), target: float): int =
  ## Smallest iteration count whose batch runs for `target` seconds, so that
  ## clock granularity and loop overhead are both far below the signal.
  result = 1
  while result < 100_000_000:
    let t = timeIters(run, result)
    if t >= target: break
    let scale = if t <= 0.0: 64.0 else: min(target / t * 1.4, 64.0)
    result = max(result + 1, int(float(result) * scale))

proc measure(run: proc(), target: float, reps: int): Timing =
  let iters = calibrate(run, target)
  var samples: seq[float]
  for _ in 0 ..< reps:
    samples.add timeIters(run, iters) / float(iters)
  samples.sort()
  Timing(best: samples[0], median: samples[samples.len div 2],
         iters: iters, reps: reps)

func rate(macs: int, seconds: float): float =
  ## GMAC/s. Zero for ops that move data rather than multiply — their cost is
  ## in loads and stores, and claiming 0 GMAC/s for a `pad` is more honest than
  ## dividing by a made-up multiply count.
  if macs == 0 or seconds <= 0.0: 0.0
  else: float(macs) / seconds / 1e9

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# INPUT
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

proc fillInput() =
  ## The same LCG the differential runner uses, for no better reason than that
  ## a benchmark and a correctness check disagreeing about their input is a
  ## confusing half-hour. Timing does not depend on the values.
  let inp = model.input0()
  var s = 12345'u32
  for i in 0 ..< model.Input0Elems:
    s = s * 1664525'u32 + 1013904223'u32
    inp[i] = int8(int32((s shr 16) and 0xFF'u32) - 128'i32)

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# REPORT
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

func shortName(s: string, width: int): string =
  ## Real TFLite names carry a whole batch-norm folding history and several
  ## fused ops joined by ';'. The first segment identifies the layer; the rest
  ## is provenance, and it goes in the TSV rather than on the terminal.
  result = s.split(';')[0]
  if result.startsWith("model/"): result = result[6 .. ^1]
  if result.len > width:
    result = "…" & result[result.len - width + 1 .. ^1]

func ms(seconds: float): string = &"{seconds * 1e3:.3f}"

proc main() =
  let tsvPath = if paramCount() >= 1: paramStr(1) else: ""
  let target = parseFloat(getEnv("STEADY_BENCH_TARGET", "0.05"))
  let reps = parseInt(getEnv("STEADY_BENCH_REPS", "7"))

  fillInput()
  model.invoke()                    # warm: fault in the arena, prime the caches

  let whole = measure(proc() = model.invoke(), target * 2, reps)

  echo &"    {model.OpCount} ops   {float(model.TotalMacs) / 1e6:.2f} MMAC   " &
       &"arena {model.ArenaSize} bytes"
  echo &"    inference   {ms(whole.best)} ms   " &
       &"{rate(model.TotalMacs, whole.best):.2f} GMAC/s" &
       &"   (median {ms(whole.median)} ms, {whole.iters}x{whole.reps})"

  # Whole-model time alone, for sweeping a compile-time choice across several
  # models without waiting for attribution that will not be read.
  if getEnv("STEADY_BENCH_OPS", "1") == "0":
    return

  # ---- per operator -------------------------------------------------------
  var times = newSeq[float](model.OpCount)
  var sumParts = 0.0
  for i in 0 ..< model.OpCount:
    let t = measure(proc() = model.invokeOp(i), target, max(3, reps div 2))
    times[i] = t.best
    sumParts += t.best

  var order = newSeq[int](model.OpCount)
  for i in 0 ..< model.OpCount: order[i] = i
  order.sort(proc(a, b: int): int = cmp(times[b], times[a]))

  echo ""
  echo &"      {\"op\":>3}  {\"kind\":<18} {\"MMAC\":>8} {\"ms\":>8} " &
       &"{\"GMAC/s\":>7} {\"%\":>6}  layer"
  var cumulative = 0.0
  for rank, i in order:
    let p = model.OpProfiles[i]
    let share = 100.0 * times[i] / sumParts
    cumulative += share
    # Everything below a twentieth of a percent is noise on this scale, and
    # MobileNetV2 has enough reshapes to bury the interesting rows in them.
    if share < 0.05 and rank > 12: continue
    echo &"      {i:>3}  {p.kind[2 .. ^1]:<18} {float(p.macs) / 1e6:>8.3f} " &
         &"{ms(times[i]):>8} {rate(p.macs, times[i]):>7.2f} {share:>6.2f}  " &
         &"{shortName(p.name, 34)}"

  # ---- per kind -----------------------------------------------------------
  # The rollup is what actually directs the work: it answers "where do the
  # multiplies go" in one line per operator type, which is the question that
  # decides whether a 1x1 fast path or a better depthwise is worth writing.
  var kindTime = initOrderedTable[string, float]()
  var kindMacs = initOrderedTable[string, int]()
  var kindCount = initOrderedTable[string, int]()
  for i in 0 ..< model.OpCount:
    let k = model.OpProfiles[i].kind[2 .. ^1]
    kindTime[k] = kindTime.getOrDefault(k) + times[i]
    kindMacs[k] = kindMacs.getOrDefault(k) + model.OpProfiles[i].macs
    kindCount[k] = kindCount.getOrDefault(k) + 1

  var kinds: seq[string]
  for k in kindTime.keys: kinds.add k
  kinds.sort(proc(a, b: string): int = cmp(kindTime[b], kindTime[a]))

  echo ""
  echo &"      {\"by kind\":<20} {\"n\":>3} {\"MMAC\":>9} {\"ms\":>8} " &
       &"{\"GMAC/s\":>7} {\"%\":>6}"
  for k in kinds:
    echo &"      {k:<20} {kindCount[k]:>3} {float(kindMacs[k]) / 1e6:>9.3f} " &
         &"{ms(kindTime[k]):>8} {rate(kindMacs[k], kindTime[k]):>7.2f} " &
         &"{100.0 * kindTime[k] / sumParts:>6.2f}"

  echo ""
  echo &"      sum of parts {ms(sumParts)} ms vs whole inference " &
       &"{ms(whole.best)} ms " &
       &"({100.0 * sumParts / whole.best:.1f}% — parts run cache-hot)"

  # ---- machine-readable ---------------------------------------------------
  if tsvPath.len > 0:
    var s = "# model\top\tkind\tmacs\toutElems\tseconds\tname\n"
    s.add &"{model.ModelName}\twhole\tinference\t{model.TotalMacs}\t" &
          &"{model.Output0Elems}\t{whole.best:.9e}\t-\n"
    for i in 0 ..< model.OpCount:
      let p = model.OpProfiles[i]
      s.add &"{model.ModelName}\t{i}\t{p.kind}\t{p.macs}\t{p.outElems}\t" &
            &"{times[i]:.9e}\t{p.name}\n"
    writeFile(tsvPath, s)

when isMainModule:
  main()
